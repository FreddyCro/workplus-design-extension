# 複製成 .env 後填入值；.env 已被 gitignore，不要 commit
# GitLab → User Settings → Applications → Add new application
#   Name:         plane-oauth-test
#   Redirect URI: http://localhost:8765/auth/gitlab/callback/
#   Confidential: ✔
#   Scopes:       read_user（只勾這一個）
GITLAB_HOST=https://misgitlab.synology.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# 本機測試用，不用改
LISTEN_PORT=8765
WEB_URL=http://localhost:8765
